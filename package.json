{
  "name": "dawn-ui-react",
  "version": "1.0.0-rc.1",
  "description": "A React component library for building polished product interfaces with composable primitives and Tailwind CSS styling.",
  "keywords": [
    "accessible-ui",
    "component-library",
    "components",
    "design-system",
    "react",
    "storybook",
    "tailwindcss",
    "typescript",
    "ui"
  ],
  "homepage": "https://github.com/PHNTMbandit/dawn-ui-react#readme",
  "bugs": {
    "url": "https://github.com/PHNTMbandit/dawn-ui-react/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PHNTMbandit/dawn-ui-react.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/styles.css"
  ],
  "main": "./dist/dawn-ui-react.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dawn-ui-react.js",
      "require": "./dist/dawn-ui-react.umd.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && vite build && pnpm run build:css",
    "build-storybook": "pnpm build:tailwind && storybook build",
    "build:css": "node -e \"require('fs').copyFileSync('src/styles/input.css', 'dist/styles.css')\"",
    "build:tailwind": "pnpm exec tailwindcss -i ./src/styles/input.css -o ./dist/styles.css",
    "chromatic": "chromatic --project-token chpt_cb6fae2c2ef2566",
    "commit": "git add . && git commit",
    "commit:skip": "git add . && git commit --no-verify",
    "cz": "cz",
    "dev": "vite",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "storybook": "concurrently 'pnpm:watch:*'",
    "test": "vitest run",
    "watch:storybook": "storybook dev -p 6006",
    "watch:tailwind": "pnpm exec tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.2.4",
    "chroma-js": "^3.2.0",
    "chromatic": "^18.9.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-resizable-panels": "^4.13.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/node": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.5",
    "cz-conventional-changelog": "^3.3.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.85.0",
    "oxlint-tailwindcss": "^1.13.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "rolldown": "1.2.6",
    "semantic-release": "^25.0.9",
    "shiki": "^4.4.3",
    "storybook": "^10.6.0",
    "typescript": "~7.0.2",
    "uuid": "^14.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
