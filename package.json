{
  "name": "dawn-ui-react",
  "version": "1.0.0-alpha.25",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PHNTMbandit/dawn-ui-react.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/styles.css"
  ],
  "main": "./dist/dawn-ui-react.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dawn-ui-react.js",
      "require": "./dist/dawn-ui-react.umd.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && vite build && pnpm run build:css",
    "build-storybook": "pnpm build:tailwind && storybook build",
    "build:css": "node -e \"require('fs').copyFileSync('src/styles/input.css', 'dist/styles.css')\"",
    "build:tailwind": "pnpm dlx @tailwindcss/cli -i ./src/styles/input.css -o ./dist/styles.css",
    "commit": "git add . && git commit",
    "commit:skip": "git add . && git commit --no-verify",
    "cz": "cz",
    "dev": "vite",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "storybook": "concurrently 'pnpm:watch:*'",
    "test": "vitest run",
    "watch:storybook": "storybook dev -p 6006",
    "watch:tailwind": "pnpm dlx @tailwindcss/cli -i ./src/styles/input.css -o ./src/styles/output.css --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-table": "^8.21.3",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@faker-js/faker": "^10.5.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-themes": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/node": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.4",
    "cz-conventional-changelog": "^3.3.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tailwindcss": "^1.6.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.0",
    "semantic-release": "^25.0.8",
    "shiki": "^4.3.1",
    "storybook": "^10.5.5",
    "typescript": "~7.0.2",
    "uuid": "^14.0.1",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "use-sync-external-store": "^1.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
